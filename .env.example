# =============================================================================
# 環境変数テンプレート
# このファイルを .env にコピーし、値を設定してください。機密情報は絶対にコミットしないこと。
# cp .env.example .env
# =============================================================================

# --- データベース（本番は Fly.io PostgreSQL で自動設定）---
# DATABASE_URL=postgresql://user:password@localhost:5432/trends_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=trends_db
# DB_USER=postgres
# DB_PASSWORD=

# --- Flask ---
# SECRET_KEY=your-secret-key
# DEBUG=false
# HOST=0.0.0.0
# FLASK_PORT=5000

# --- トレンドAPI（必須）---
# News API（CNN/Newsトレンド）
# NEWS_API_KEY=

# World News API
# WORLDNEWS_API_KEY=

# Listen Notes API（Podcastトレンド）
# LISTEN_API_KEY=

# 楽天API（楽天トレンド・書籍トレンド）
# RAKUTEN_APP_ID=
# RAKUTEN_AFFILIATE_ID=

# Amazonアソシエイト（書籍・映画トレンド）
# AMAZON_AFFILIATE_ID=

# eBay API（eBayトレンド）
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_CAMPAIGN_ID=         # キャンペーンID（10桁、EPN必須）
# EBAY_AFFILIATE_ID=        # 後方互換: campid として使用。または mkrid 形式(711-53200-19255-0)
# EBAY_ROTATION_ID=         # ローテーションID（省略時は US: 711-53200-19255-0）

# Twitch API
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# YouTube API
# YOUTUBE_API_KEY=

# Spotify API（音楽トレンド）
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# --- オプションAPI ---
# GitHub API（Personal Access Token）。未設定または無効時は未認証レートで Search API が使えるが厳しい。
# classic / fine-grained どちらも可。fine-grained は Repo 読み取りなど Search に必要な権限を付与すること。
# 本番 Fly.io: fly secrets set GITHUB_ACCESS_TOKEN=ghp_...  （ログに出さない）
# GITHUB_ACCESS_TOKEN=

# TMDB API（映画トレンド）
# TMDB_API_KEY=

# e-Stat API（統計トレンド）
# ESTAT_API_KEY=

# Google Books API（書籍検索）
# GOOGLE_BOOKS_API_KEY=

# BLS API（米国労働統計局、1日500リクエスト）
# BLS_API_KEY=

# Reddit API
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=trends_dashboard

# Product Hunt API
# PRODUCTHUNT_CLIENT_ID=
# PRODUCTHUNT_CLIENT_SECRET=

# Wikipedia API（オプション）
# WIKIPEDIA_ACCESS_TOKEN=

# --- Google Cloud（Google Trends）---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# または Base64: GOOGLE_APPLICATION_CREDENTIALS_CONTENT=

# --- トレンドスナップショット（7時起点 business_day × スロット 01/07/13/19）---
# TREND_SNAPSHOTS_ENABLED=true
# 各 series の保存件数（タイトル・キーワードの薄い配列）
# TREND_SNAPSHOT_TOP_N=10
# 株・仮想通貨 series を保存しない（既定 true）
# TREND_SNAPSHOT_EXCLUDE_MARKET=true

# --- メール送信（サブスクリプション機能、未使用なら空で可）---
# SENDER_EMAIL=
# SENDER_PASSWORD=
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# --- その他 ---
# アラート通知・日次 X 投稿案 Discord（同一 Webhook）。未設定ならアラート / --discord 無効
# DISCORD_WEBHOOK_URL=
# 長時間ジョブで完了通知が届かないとき原因切り分け用: スケジューラ一括取得の「開始」だけ Discord に送る（true/1/yes）。本番は fly.toml で true
# DISCORD_NOTIFY_SCHEDULER_START=false
# メモリ逼迫の事前警告（OOM 直後はアプリから検知不可）。true で RSS が上限に近いとき Discord
# DISCORD_MEMORY_PRESSURE_ALERT=true
# MEMORY_PRESSURE_WARN_RATIO=0.82
# MEMORY_PRESSURE_CRITICAL_RATIO=0.90
# MEMORY_WATCHDOG_INTERVAL_SEC=45
# MEMORY_PRESSURE_ALERT_COOLDOWN_SEC=1200
# cgroup が取れない環境向け上限（MB）。本番 VM が 1024MB のときは 1024 に合わせると警告が現実に近い
# MEMORY_LIMIT_MB=1024

# AIサマリー Fake door（Top1 ティーザー + Top5 CTA→モーダル「準備中」。GA: ai_summary_top5_click / fake_door_view）。false で従来のローカルTop5モックのみ
# ENABLE_AI_SUMMARY_FAKE_DOOR=true

# --- AI 日次サマリー（scripts/generate_ai_daily_summary.py）---
# 前日の trend_daily_snapshots（スロット 07/13/19/01）から Markdown を生成。GitHub Actions では Repository secrets に設定。
# OPENAI_API_KEY=sk-...
# 省略時 gpt-4o-mini（品質重視なら gpt-4o 等に変更可）
# OPENAI_SUMMARY_MODEL=gpt-4o-mini

# --- AI 週次サマリー（scripts/generate_ai_weekly_summary.py）---
# docs/summaries/daily/*.md のみ入力（スナップショット・HTTP API 不要）。モデルは日次と同じ OPENAI_SUMMARY_MODEL を流用可。
# OPENAI_API_KEY=sk-...
# OPENAI_SUMMARY_MODEL=gpt-4o-mini

# --- X 日次投稿文案（scripts/generate_daily_x_post_series.py）---
# 出力: docs/x_post_samples/daily/YYYY-MM-DD.md（--output-dir / --output-file で変更可）
# DATABASE_URL で trend_daily_snapshots を読む。GitHub 上は --from-api で HTTP。

# Google Analytics（オプション）
# GOOGLE_ANALYTICS_ID=

# Buy Me a Coffee（オプション）
# BUY_ME_A_COFFEE_USERNAME=

# --- 開発・運用 ---
# ローカル開発時: ダミーデータで上書き（APIキー不要）
# USE_DUMMY_DATA=true

# スケジューラ: ローカルではデフォルト無効（Fly.io のみ有効）。ローカルで有効にしたい場合:
# ENABLE_SCHEDULER=true

# スケジューラ DB 分散ロックの保持時間（分）。一括取得が長いほど大きめに（本番 fly.toml 例: 90）
# TRENDS_SCHEDULER_LOCK_MINUTES=90

# トレンド一括取得の同時実行数（手動/API 実行時に利用）
# TREND_REFRESH_MAX_CONCURRENT=2
# TREND_REFRESH_BATCH_DELAY_SECONDS=2

# 定期スケジューラ（1/7/13/19時）の低負荷モード設定
# true: 低負荷モードを使用（OOM対策） / false: TREND_REFRESH_* をそのまま使用
# TRENDS_SCHEDULER_LOW_MEMORY_MODE=true
# TRENDS_SCHEDULER_LOW_MEMORY_MAX_CONCURRENT=2
# TRENDS_SCHEDULER_LOW_MEMORY_BATCH_DELAY_SECONDS=1

# 株価取得の最大銘柄数
# STOCK_MAX_TICKERS=45

# ログレベル
# LOG_LEVEL=INFO
