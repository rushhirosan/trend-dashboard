# =============================================================================
# 環境変数テンプレート
# このファイルを .env にコピーし、値を設定してください。機密情報は絶対にコミットしないこと。
# cp .env.example .env
# =============================================================================

# --- データベース（本番は Fly.io PostgreSQL で自動設定）---
# DATABASE_URL=postgresql://user:password@localhost:5432/trends_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=trends_db
# DB_USER=postgres
# DB_PASSWORD=

# --- Flask ---
# SECRET_KEY=your-secret-key
# DEBUG=false
# HOST=0.0.0.0
# FLASK_PORT=5000

# --- トレンドAPI（必須）---
# News API（CNN/Newsトレンド）
# NEWS_API_KEY=

# World News API
# WORLDNEWS_API_KEY=

# Listen Notes API（Podcastトレンド）
# LISTEN_API_KEY=

# 楽天API（楽天トレンド・書籍トレンド）
# RAKUTEN_APP_ID=
# RAKUTEN_AFFILIATE_ID=

# Amazonアソシエイト（書籍・映画トレンド）
# AMAZON_AFFILIATE_ID=

# eBay API（eBayトレンド）
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_AFFILIATE_ID=

# Twitch API
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# YouTube API
# YOUTUBE_API_KEY=

# Spotify API（音楽トレンド）
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# --- オプションAPI ---
# GitHub API（未設定時は60回/時制限、設定時5000回/時）
# GITHUB_ACCESS_TOKEN=

# TMDB API（映画トレンド）
# TMDB_API_KEY=

# e-Stat API（統計トレンド）
# ESTAT_API_KEY=

# Google Books API（書籍検索）
# GOOGLE_BOOKS_API_KEY=

# BLS API（米国労働統計局、1日500リクエスト）
# BLS_API_KEY=

# Reddit API
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=trends_dashboard

# Product Hunt API
# PRODUCTHUNT_CLIENT_ID=
# PRODUCTHUNT_CLIENT_SECRET=

# Wikipedia API（オプション）
# WIKIPEDIA_ACCESS_TOKEN=

# --- Google Cloud（Google Trends）---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# または Base64: GOOGLE_APPLICATION_CREDENTIALS_CONTENT=

# --- メール送信（サブスクリプション機能、未使用なら空で可）---
# SENDER_EMAIL=
# SENDER_PASSWORD=
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587

# --- その他 ---
# アラート通知（Discord Webhook）。未設定ならアラート無効
# DISCORD_WEBHOOK_URL=

# Google Analytics（オプション）
# GOOGLE_ANALYTICS_ID=

# Buy Me a Coffee（オプション）
# BUY_ME_A_COFFEE_USERNAME=

# --- 開発・運用 ---
# ローカル開発時: ダミーデータで上書き（APIキー不要）
# USE_DUMMY_DATA=true

# スケジューラ無効化（ローカル開発用）
# ENABLE_SCHEDULER=false

# トレンド一括取得の同時実行数（512MB VMでは 2 推奨）
# TREND_REFRESH_MAX_CONCURRENT=2
# TREND_REFRESH_BATCH_DELAY_SECONDS=2

# 株価取得の最大銘柄数
# STOCK_MAX_TICKERS=45

# ログレベル
# LOG_LEVEL=INFO
