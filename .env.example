# アラート通知（Discord Webhook）
# チャンネル設定 → 連携サービス → Webhook で URL を取得
# 未設定ならアラートは無効（エラー・異常検出時も通知しない）
DISCORD_WEBHOOK_URL=

# BLS（米国労働統計局）API - 登録推奨（1日500リクエスト）。未登録は制限あり。
# https://data.bls.gov/registrationEngine/
# BLS_API_KEY=

# ローカル開発時: トレンドAPIをダミーデータで上書き（true のとき全トレンドがダミーを返す。APIキー不要）
# USE_DUMMY_DATA=true

# スケジューラ: 単一インスタンスで0本になる場合は false にするとファイルロックのみで確実に1本だけ実行
# TRENDS_SCHEDULER_USE_DB_LOCK=false
